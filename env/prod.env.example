# Production env is generated from 1Password:
#   op inject -i env/prod.env.tpl -o env/prod.env
#
# Or just run: make env
#
# Secrets are stored in 1Password vault "infra", item "vibez"

PORT=3005
RADIO_URL=https://vibez.bike-shed.io
GOOGLE_CLIENT_ID=      # op://infra/vibez/google-client-id
GOOGLE_CLIENT_SECRET=  # op://infra/vibez/google-client-secret
SESSION_SECRET=        # op://infra/vibez/session-secret (openssl rand -hex 32)
ADMIN_EMAILS=          # op://infra/vibez/admin-emails, comma-separated
BANNED_EMAILS=         # op://infra/vibez/banned-emails, comma-separated, may be empty
SLACK_BOT_TOKEN=    # op://infra/vibez/slack-bot-token
SLACK_APP_TOKEN=    # op://infra/vibez/slack-app-token
SLACK_NOTIFICATIONS_WEBHOOK_URL=  # injected by scripts/deploy.sh from company 1Password: op://Eng Admin/gz3fstsnolbqgvmqgfe6w72lau/naivtgjlnve3fxooq5dzstknvm
SOUNDCLOUD_CLIENT_ID=  # op://infra/vibez/soundcloud-client-id
