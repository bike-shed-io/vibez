# AUR recipe prepared for publication; the desktop client currently lives on this branch.
pkgname=vibez-desktop-git
pkgver=0.2.0.r105.gc936343
pkgrel=1
pkgdesc='Vibez synchronized radio client for Linux and Waybar (development version)'
arch=('any')
url='https://github.com/bike-shed-io/vibez'
license=('LicenseRef-Unknown')
depends=('electron44' 'nodejs')
makedepends=('git')
optdepends=('waybar: desktop bar module' 'rofi: right-click menu')
provides=('vibez-desktop')
conflicts=('vibez-desktop')
source=('vibez::git+https://github.com/bike-shed-io/vibez.git#branch=feat/linux-client')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/vibez"
  printf '%s.r%s.g%s' "$(node -p 'require("./desktop/package.json").version')" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
  cd "$srcdir/vibez/desktop"
  node --test tests/*.test.cjs
}

package() {
  cd "$srcdir/vibez/desktop"
  install -dm755 "$pkgdir/usr/share/vibez-desktop/assets"
  install -m644 ./*.cjs package.json offline.html offline.css "$pkgdir/usr/share/vibez-desktop/"
  cp -R shared platform "$pkgdir/usr/share/vibez-desktop/"
  install -m644 assets/* "$pkgdir/usr/share/vibez-desktop/assets/"
  install -Dm755 platform/linux/vibez "$pkgdir/usr/bin/vibez"
  install -Dm644 platform/linux/integration/vibez.desktop "$pkgdir/usr/share/applications/vibez.desktop"
  install -Dm644 assets/vibez.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/vibez.png"
  install -Dm644 platform/linux/integration/vibez.service "$pkgdir/usr/lib/systemd/user/vibez.service"
  install -dm755 "$pkgdir/usr/share/doc/vibez-desktop"
  install -m644 README.md platform/linux/integration/waybar.* "$pkgdir/usr/share/doc/vibez-desktop/"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
